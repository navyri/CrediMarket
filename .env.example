# P2-2.7 · Plantilla de configuración. Copiar a `.env` (gitignored) y completar.
# NUNCA versionar el archivo .env real (§9 secretos, §15.3).

# --- PostgreSQL (instancia única, esquemas separados) ---
POSTGRES_USER=credimarket
POSTGRES_PASSWORD=CAMBIAR_postgres_local
POSTGRES_DB=credimarket
# Credenciales por servicio (solo se usan dentro de Compose/local; restringidas por esquema)
PASSWORD_PRODUCTOS=CAMBIAR_prod_local
PASSWORD_CLIENTES=CAMBIAR_cli_local
PASSWORD_PRESTAMOS=CAMBIAR_pre_local
PASSWORD_INVENTORY=CAMBIAR_inv_local

# --- RabbitMQ (P2-DEC-011) ---
RABBITMQ_USER=credimarket
RABBITMQ_PASSWORD=CAMBIAR_rabbit_local
RABBITMQ_DEFAULT_VHOST=/credimarket

# --- Redis (solo Productos) ---
REDIS_PASSWORD=CAMBIAR_redis_local

# --- MLflow (infraestructura) ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5000

# --- JWT (P2-DEC-012) ---
JWT_SECRET=CAMBIAR_jwt_local_largo_32+
JWT_ALGORITHM=HS256
JWT_EXP_MIN=30

# --- Tiempos de espera (§4 / máquina de estados §4) ---
RESERVA_VENCIMIENTO_SEG=600
ESPERA_EVENTO_RESERVA_SEG=30
ESPERA_EVENTO_LIBERACION_SEG=15
REINTENTOS_BROKER=3

# --- URLs de servicio (interno Compose) ---
URL_PRODUCTOS=http://productos:8001
URL_CLIENTES=http://clientes:8002
URL_PRESTAMOS=http://prestamos:8003
URL_INVENTARIO=http://inventario:8004
BROKER_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2Fcredimarket
REDIS_URL=redis://redis:6379/0

# --- CORS / Frontend (§10: URLs configurables, sin secretos) ---
# 5174 es el puerto de respaldo de Vite cuando 5173 está ocupado en la máquina.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
VITE_API_PRODUCTOS=http://localhost:8001
VITE_API_CLIENTES=http://localhost:8002
VITE_API_PRESTAMOS=http://localhost:8003
VITE_API_INVENTARIO=http://localhost:8004
VITE_MLFLOW_URL=http://localhost:5000

# --- Modelo activo (§8.D promoción explícita) ---
MODELO_ACTIVO_VERSION=
MODELO_DIR=/var/lib/credimarket/modelos
# Tasa oficial del programa (constante del histórico: 0.0180 mensual) y
# regla de control previa al modelo (P2-7: obligaciones/ingresos ≥ ratio →
# rechazo por regla, sin invocar el modelo).
TASA_MENSUAL_OFICIAL=0.018
RATIO_DEUDA_INGRESO_MAX=1.0
INTERVALO_RECHARGA_MODELO_SEG=10
URL_MLFLOW=http://mlflow:5000

# --- Semilla (§8.A reproducibilidad) ---
RANDOM_SEED=42

# --- Cuentas de demo (fuera del repo en valores reales; ver guía de demo) ---
ADMIN_EMAIL=admin@credimarket.demo
ADMIN_PASSWORD=CAMBIAR_admin_local
